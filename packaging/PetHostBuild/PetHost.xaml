<Window x:Class="SumikaPetHost.PetHost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="76" Height="76" Loaded="OnLoaded">
  <Grid Background="Transparent">
    <!-- Compact orb is drawn natively: no WebView2 compositor in the resting state. -->
    <Canvas x:Name="OrbLayer" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"
            MouseLeftButtonDown="OnOrbDown" MouseMove="OnOrbMove" MouseLeftButtonUp="OnOrbUp" Background="Transparent">
      <Ellipse x:Name="Halo" Width="72" Height="72" Canvas.Left="2" Canvas.Top="2" Opacity="0.55">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0.62" Color="#00B4496A" />
            <GradientStop Offset="0.98" Color="#33B4496A" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="Body" Width="54" Height="54" Canvas.Left="11" Canvas.Top="10">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.34,0.26" Center="0.34,0.26" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Offset="0.04" Color="#FDF8F1" />
            <GradientStop Offset="0.58" Color="#F9E8ED" />
            <GradientStop Offset="1" Color="#FDF8F1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect>
          <DropShadowEffect BlurRadius="7" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#503C32" />
        </Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="54" Height="54" Canvas.Left="11" Canvas.Top="10" Stroke="#B4496A" StrokeThickness="1" Opacity="0.18" />
      <Ellipse x:Name="Ring" Width="44" Height="44" Canvas.Left="16" Canvas.Top="15" Stroke="#B4496A" StrokeThickness="1" Opacity="0.16" />
      <TextBlock Text="S" FontFamily="Georgia, SimSun, serif" FontSize="22" FontWeight="SemiBold" Foreground="#972F4F"
                 Canvas.Left="0" Canvas.Top="20" Width="76" TextAlignment="Center" />
      <TextBlock Text="✿" FontFamily="Segoe UI Symbol" FontSize="10" Foreground="#B4496A"
                 Canvas.Left="50" Canvas.Top="8" Opacity="0.85" />
    </Canvas>
    <!-- Expanded card hosts the web preview; created lazily on first expand. -->
    <Border x:Name="CardLayer" Width="380" Height="540" CornerRadius="16" Background="#FFFBF4"
            BorderBrush="#E7C6CF" BorderThickness="1" Visibility="Collapsed" ClipToBounds="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.24" Color="#503C32" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="24" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFBF4" CornerRadius="16,16,0,0">
          <Button x:Name="CollapseButton" Content="−" Width="28" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#A88A90"
                  FontSize="15" Cursor="Hand" Click="CollapseHost" ToolTip="收起到悬浮球" />
        </Border>
        <wv2:WebView2 Grid.Row="1" x:Name="Browser" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" />
        <Button x:Name="CloseButton" Content="×" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,5,5,0" Opacity="0.8" Click="CloseHost" ToolTip="关闭桌宠窗口" Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</Window>
