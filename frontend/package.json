{
  "name": "sumika-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Sumika local-first browser shell with a bundled VRM adapter.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vrm": "esbuild src/vrm-viewer.js --bundle --format=esm --minify --outfile=public/vendor/sumika-vrm-viewer.js",
    "test:e2e": "node ../tools/run-playwright.mjs",
    "dev:desktop": "vite --host 127.0.0.1 --port 8771",
    "tauri:dev": "cd .. && tauri dev --no-dev-server-wait",
    "tauri:check": "cd .. && tauri info"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "three": "^0.185.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
