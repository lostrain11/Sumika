{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sumika",
  "version": "0.1.0",
  "identifier": "com.sumika.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:8771",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sumika",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/sumika-icon-sharp.ico",
      "icons/sumika-icon-sharp-16.png",
      "icons/sumika-icon-sharp-24.png",
      "icons/sumika-icon-sharp-32.png",
      "icons/sumika-icon-sharp-48.png",
      "icons/sumika-icon-sharp-64.png",
      "icons/sumika-icon-sharp-128.png",
      "icons/sumika-icon-sharp-256.png"
    ]
  }
}
